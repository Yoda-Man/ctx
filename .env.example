# ctx - local development environment
# Copy this file to .env and fill in your values. .env is gitignored.
# ctx also reads a .env in the directory you run it from.
#
# ctx runs entirely on your machine: no cloud model, no API key.

# =============================================================================
# Answers: a local Ollama model (for `ctx ask` and `ctx chat`; search needs none)
# =============================================================================
# Choose the model in ~/.ctx/config.toml:
#   ollama pull qwen3.5:9b && ctx config set default_model qwen3.5:9b
#
# Where Ollama runs, if not the default:
# OLLAMA_HOST=http://localhost:11434

# =============================================================================
# Embeddings
# =============================================================================
# Default: Xenova/bge-large-en-v1.5 (1024 dimensions) run locally.
# The first run downloads about 340 MB to ~/.ctx/models, and the first search
# about 290 MB more for the reranker (search.rerank is on by default).
#
# To embed with Ollama instead:
#   ctx config set embedding.provider ollama
#   ctx config set embedding.model mxbai-embed-large
