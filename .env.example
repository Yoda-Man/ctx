# ctx - local development environment
# Copy this file to .env and fill in your values. .env is gitignored.
# ctx also reads a .env in the directory you run it from.

# =============================================================================
# LLM provider for `ctx ask` and `ctx chat` (choose one; search needs none)
# =============================================================================
# The provider itself is chosen in ~/.ctx/config.toml:
#   ctx config set default_provider anthropic|openai|ollama

# Anthropic Claude (the default provider)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
# OPENAI_API_KEY=sk-...

# Any OpenAI-compatible API (Z.AI, OpenRouter, etc.). When set, it is tried
# first if the chosen provider is unavailable.
# OPENAI_COMPATIBLE_API_KEY=your-api-key-here
# OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_COMPATIBLE_MODEL=your-model

# Ollama, local, no key needed
# OLLAMA_HOST=http://localhost:11434

# =============================================================================
# Embeddings
# =============================================================================
# Default: Xenova/bge-large-en-v1.5 (1024 dimensions) run locally, no API key.
# The first run downloads about 340 MB to ~/.ctx/models, and the first search
# about 290 MB more for the reranker (search.rerank is on by default).
#
# To embed with Ollama instead:
#   ctx config set embedding.provider ollama
#   ctx config set embedding.model mxbai-embed-large
