{
  "name": "yodaman-ctx",
  "version": "1.1.0",
  "description": "Cross-project context agent CLI (ctx): semantic search and Q&A across codebases. YodaMan's maintained fork of Context Expert.",
  "type": "module",
  "bin": {
    "ctx": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "dev": "tsup --watch",
    "start": "node ./dist/cli.js",
    "dev:chat": "node ./dist/cli.js chat",
    "dev:index": "node ./dist/cli.js index",
    "dev:ask": "node ./dist/cli.js ask",
    "dev:search": "node ./dist/cli.js search",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run check:latest && npm run build && npm test",
    "check:latest": "npm outdated"
  },
  "keywords": [
    "ai",
    "cli",
    "codebase",
    "context",
    "rag",
    "search",
    "yodaman"
  ],
  "author": "YodaMan (fork of Context Expert by draco)",
  "license": "MIT",
  "homepage": "https://github.com/Yoda-Man/ctx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yoda-Man/ctx.git"
  },
  "bugs": {
    "url": "https://github.com/Yoda-Man/ctx/issues"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@iarna/toml": "^2.2.5",
    "better-sqlite3": "^13.0.3",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "dotenv": "^18.0.9",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.14",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "ora": "^9.4.1",
    "tree-sitter": "^0.25.1",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "turndown": "^7.2.4",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^5.0.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "protobufjs": true,
    "sharp": true,
    "tree-sitter": true,
    "tree-sitter-javascript": true,
    "tree-sitter-python": true,
    "tree-sitter-typescript": true,
    "onnxruntime-node": true,
    "fsevents": false
  },
  "overrides": {
    "tree-sitter-typescript": {
      "tree-sitter": "$tree-sitter"
    }
  }
}
